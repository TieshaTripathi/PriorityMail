# PriorityMail Mobile Environment Configuration
# Copy this file to .env or configure in app.json / EAS Build secrets

# Backend API endpoint (used when connecting to live backend)
EXPO_PUBLIC_API_URL=http://localhost:4000

# Google OAuth Client IDs (created in Google Cloud Console -> Credentials)
# Leave blank to run in fully interactive local mock mode
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=

# Optional: Enable live backend sync (true / false)
EXPO_PUBLIC_ENABLE_LIVE_SYNC=false
