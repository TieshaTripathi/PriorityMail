# PriorityMail Backend — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to git.

# ── Server ───────────────────────────────────────────────────────
PORT=4000

# ── Database ─────────────────────────────────────────────────────
# Path to the SQLite database file (created automatically).
DATABASE_PATH=./data/prioritymail.db

# ── Encryption ───────────────────────────────────────────────────
# 64-character hex string (32 bytes) used to encrypt Gmail refresh tokens.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ── Session ──────────────────────────────────────────────────────
# Random string used to sign session cookies.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# ── Google OAuth (Login — identity scopes only) ──────────────────
# From Google Cloud Console > APIs & Services > Credentials
# Create a "Web application" OAuth 2.0 Client ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redirect URI for the login flow.
# Must be registered EXACTLY in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Redirect URI for the Gmail account connection flow.
# Must be registered EXACTLY in Google Cloud Console.
GMAIL_REDIRECT_URI=http://localhost:4000/api/accounts/connect/callback

# ── Web App ──────────────────────────────────────────────────────
# The origin of the web frontend (used for CORS and OAuth redirects).
WEB_APP_URL=http://localhost:5173
