# PriorityMail Backend — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to git.

# ── Server ───────────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────
# PostgreSQL connection string for production persistence (Render, Neon, Supabase, etc.).
# When set, PriorityMail automatically connects to PostgreSQL and uses persistent pg sessions.
# If unset, PriorityMail falls back to local SQLite at DATABASE_PATH.
DATABASE_URL=

# SQLite fallback path for local development
DATABASE_PATH=./data/prioritymail.db

# ── Google Cloud Pub/Sub (Real-Time Gmail Watch) ─────────────────
# Full topic path for Gmail API users.watch push notifications:
# Format: projects/<your-gcp-project-id>/topics/<your-topic-name>
PUBSUB_TOPIC_NAME=

# ── Web Push Notifications (VAPID) ──────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@prioritymail.app

# ── Frontend URL ─────────────────────────────────────────────────
# The origin of the web frontend (used for CORS and OAuth redirects).
# Local: http://localhost:5173
# Production: https://priority-mail-zeta.vercel.app
FRONTEND_URL=http://localhost:5173

# Legacy compatibility alias
WEB_APP_URL=http://localhost:5173

# ── Secrets ──────────────────────────────────────────────────────
# 64-character hex string (32 bytes) used to encrypt Gmail refresh tokens with AES-256-GCM.
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Legacy compatibility alias
ENCRYPTION_KEY=

# Random string used to sign session cookies.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# ── Google OAuth Credentials ─────────────────────────────────────
# From Google Cloud Console > APIs & Services > Credentials
# Create a "Web application" OAuth 2.0 Client ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Google OAuth Redirect URIs ───────────────────────────────────
# Redirect URI for the user login flow (must match Google Cloud Console).
# Local: http://localhost:4000/api/auth/google/callback
# Production: https://<your-render-service>.onrender.com/api/auth/google/callback
GOOGLE_AUTH_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Redirect URI for connecting additional Gmail accounts (must match Google Cloud Console).
# Local: http://localhost:4000/api/accounts/google/callback
# Production: https://<your-render-service>.onrender.com/api/accounts/google/callback
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:4000/api/accounts/google/callback

# Legacy compatibility aliases
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
GMAIL_REDIRECT_URI=http://localhost:4000/api/accounts/google/callback
