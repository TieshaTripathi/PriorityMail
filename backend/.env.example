# PriorityMail Backend — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to git.

# ── Server ───────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────
# Path to the SQLite database file (created automatically).
DATABASE_PATH=./data/prioritymail.db

# ── Frontend URL ─────────────────────────────────────────────────
# The origin of the web frontend (used for CORS and OAuth redirects).
# Local: http://localhost:5173
# Production: https://priority-mail-zeta.vercel.app
FRONTEND_URL=http://localhost:5173

# Legacy compatibility alias
WEB_APP_URL=http://localhost:5173

# ── Secrets ──────────────────────────────────────────────────────
# 64-character hex string (32 bytes) used to encrypt Gmail refresh tokens with AES-256-GCM.
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Legacy compatibility alias
ENCRYPTION_KEY=

# Random string used to sign session cookies.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# ── Google OAuth Credentials ─────────────────────────────────────
# From Google Cloud Console > APIs & Services > Credentials
# Create a "Web application" OAuth 2.0 Client ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Google OAuth Redirect URIs ───────────────────────────────────
# Redirect URI for the user login flow (must match Google Cloud Console).
# Local: http://localhost:4000/api/auth/google/callback
# Production: https://<your-render-service>.onrender.com/api/auth/google/callback
GOOGLE_AUTH_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Redirect URI for connecting additional Gmail accounts (must match Google Cloud Console).
# Local: http://localhost:4000/api/accounts/google/callback
# Production: https://<your-render-service>.onrender.com/api/accounts/google/callback
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:4000/api/accounts/google/callback

# Legacy compatibility aliases
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
GMAIL_REDIRECT_URI=http://localhost:4000/api/accounts/google/callback
