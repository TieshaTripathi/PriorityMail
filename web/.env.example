# PriorityMail Web — Environment Variables
# Copy this to .env and fill in your values.
# Only VITE_* variables are bundled into the browser. Never put secrets here.

# Supabase Configuration
VITE_SUPABASE_URL=https://<your-project-id>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend API base URL (optional fallback for local emulation)
# For local development: http://localhost:4000
VITE_API_URL=http://localhost:4000

# Web Push VAPID public key (optional)
VITE_VAPID_PUBLIC_KEY=
