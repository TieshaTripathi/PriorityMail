# PriorityMail Web — Environment Variables
# Copy this to .env and fill in your values.
# Only VITE_* variables are bundled into the browser. Never put secrets here.

# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:4000

# Your Google OAuth client ID (public — same value used on backend)
# Only needed if you build a one-click login button that calls Google directly.
# PriorityMail uses the backend-driven flow, so this is optional.
VITE_GOOGLE_CLIENT_ID=

# Web Push VAPID public key (future — keep private key on server only)
VITE_VAPID_PUBLIC_KEY=
