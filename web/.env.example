# PriorityMail Web — Environment Variables
# Copy this to .env and fill in your values.
# Only VITE_* variables are bundled into the browser. Never put secrets here.

# Backend API base URL (no trailing slash)
# For local development: http://localhost:4000
# For production (Render / deployed backend): https://<your-backend-service>.onrender.com
VITE_API_URL=http://localhost:4000

# Legacy compatibility alias (optional)
VITE_API_BASE_URL=http://localhost:4000

# Your Google OAuth client ID (optional - only needed for frontend-initiated flows)
VITE_GOOGLE_CLIENT_ID=

# Web Push VAPID public key (future - keep private key on server only)
VITE_VAPID_PUBLIC_KEY=
